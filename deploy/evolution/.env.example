# Copie para .env na VM e preencha. NUNCA comite o .env preenchido.

# ------------------------------------------------------------
# Endereço público
# ------------------------------------------------------------
# URL pública, a mesma do server_name do nginx. O Evolution monta as URLs de
# QR code e de mídia a partir daqui, então precisa ser https e externa —
# 127.0.0.1 aqui faz o QR code chegar quebrado no painel.
#
# nip.io resolve qualquer IP sem registro de domínio:
# 129.153.10.20.nip.io -> 129.153.10.20
# Troque pelo IP público da VM da Oracle.
SERVER_URL=https://SEU-IP-PUBLICO.nip.io
SERVER_TYPE=http
SERVER_PORT=8080

# ------------------------------------------------------------
# Autenticação
# ------------------------------------------------------------
# Chave mestra: quem tem isso controla TODOS os WhatsApp conectados.
# Gere com: openssl rand -hex 32
AUTHENTICATION_API_KEY=TROQUE-ME
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# ------------------------------------------------------------
# Banco
# ------------------------------------------------------------
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=TROQUE-ME

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:TROQUE-ME@evolution-postgres:5432/evolution?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=evolution_fidelidade

# Guardar histórico de mensagem no Postgres da VM não serve pra nada aqui —
# quem manda status pro painel é o webhook, e o disco da free tier é pequeno.
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

# ------------------------------------------------------------
# Cache
# ------------------------------------------------------------
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# ------------------------------------------------------------
# Webhook
# ------------------------------------------------------------
# Global desligado: cada instância recebe a URL do tenant dela na criação,
# igual ao desenho multi-tenant que o painel já usa.
WEBHOOK_GLOBAL_ENABLED=false

# ------------------------------------------------------------
# Log
# ------------------------------------------------------------
LOG_LEVEL=ERROR,WARN
LOG_COLOR=false
DEL_INSTANCE=false

# ------------------------------------------------------------
# QR Code
# ------------------------------------------------------------
QRCODE_LIMIT=10

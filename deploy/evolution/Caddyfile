# TLS automático (Let's Encrypt). O domínio vem do .env — com nip.io não
# precisa registrar nada: 129.153.10.20.nip.io resolve pro próprio IP.
{$EVOLUTION_DOMAIN} {
	encode gzip

	# O Manager (painel web do Evolution) não é publicado: ele expõe a apikey
	# na interface. Administra pela API mesmo, ou abre por túnel SSH.
	reverse_proxy api:8080

	log {
		output file /data/access.log
		format json
	}
}
